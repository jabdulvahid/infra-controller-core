# /etc/enclosure/dpu.env — written by the Enclosure tool's cloud-init seed.
# Every value comes from the enclosure file; nothing here is guessed.
#
# Interface identity (MACs the enclosure assigned to this DPU VM's NICs):
DPU_OOB_MAC=02:00:00:01:00:03        # becomes oob_net0 (BMC/underlay network, DHCP from NICo)
DPU_UPLINK_MAC=02:00:00:01:00:04     # becomes p0_if / p0 (to the fabric leaf; BGP unnumbered)
DPU_HOSTLINK_MAC=02:00:00:01:00:05   # becomes pf0hpf_if / pf0hpf (private cable to the server VM)
# What the agent reports as the DPU's factory MAC (host PF MAC; must equal the
# host MAC the host BMC's bmc-mock advertises; read by nico-flint):
DPU_FACTORY_MAC=02:00:00:01:00:02
# DPU serial (also set as the libvirt <sysinfo> product_serial; must equal the
# DPU serial the host BMC's bmc-mock reports for pairing: "MT" + OOB MAC w/o colons):
DPU_SERIAL=MT020000010003
# NVUE REST credentials the NICo agent uses (user created inside the HBN container):
NVUE_USERNAME=carbide
NVUE_PASSWORD=change-me
# NICo's arm64 container images for the agent and the DHCP server (baked at
# build time or reachable from the DPU):
NICO_DPU_AGENT_IMAGE=localhost/nico/forge-dpu-agent:enclosure
NICO_DHCP_SERVER_IMAGE=localhost/nico/forge-dhcp-server:enclosure
