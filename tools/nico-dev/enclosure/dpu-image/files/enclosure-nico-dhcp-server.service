[Unit]
Description=Enclosure DPU: real NICo forge DHCP server (container)
# vmctl's vm-nico-dhcp-server.service re-pointed at real HBN.
After=network-online.target enclosure-hbn.service
Requires=enclosure-hbn.service
Before=enclosure-nico-dpu-agent.service

[Service]
EnvironmentFile=/etc/vm/environment
Environment=RUST_LOG=info
ExecStartPre=-/usr/bin/podman rm -f enclosure-nico-dhcp-server
ExecStart=/usr/bin/podman run --name enclosure-nico-dhcp-server --network host \
  --cap-add=NET_ADMIN --cap-add=NET_RAW --cap-add=NET_BIND_SERVICE \
  --env RUST_LOG \
  --volume /var/lib/hbn/var/support:/var/support:z \
  ${NICO_DHCP_SERVER_IMAGE} \
  --grpc-listen-addr=127.0.0.1:10079 \
  --metrics-listen-addr=127.0.0.1:10080
ExecStop=-/usr/bin/podman stop -t 10 enclosure-nico-dhcp-server
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
