#
# nico-dev — ARM64 nico image build (dev variant)
#
# Based on dev/docker/Dockerfile.release-container-aarch64 with:
#   1. No CI quality gates (no cargo make, no clippy/lints/license checks)
#   2. Plain cargo build of the shipped package set (PROFILE release or dev,
#      see below), parallelism from CARGO_BUILD_JOBS (build-dev-nico.py sizes it from the
#      docker daemon's CPUs and memory; default 2 = the old fixed value that
#      kept a 16 GB Mac's colima VM from running out of memory)
#   3. Separate sccache cache ID (sccache-aarch64-dev) from production
#   4. A persistent cargo target directory (BuildKit cache mount, one per
#      source checkout: CHECKOUT_ID from build-dev-nico.py) and a shared
#      cargo registry cache, so a rebuild after a code change recompiles
#      only what changed instead of the whole workspace. The target dir is
#      per checkout because cargo judges freshness by mtime and two
#      checkouts mounted at the same path would reuse each other's crates
#      (20260918-#1). Caches live in the docker daemon; `docker builder
#      prune` clears them.
#
# The runtime stage is structurally identical to production: same binaries,
# same COPY paths, same directory layout — compatible with Nico helm charts.
#
# Copied into {infra_controller_repo}/nico-dev-docker/ by build-dev-nico.py
# before the docker build runs. The nico repo is never permanently modified.
#
# The ARG names say AARCH64 for historical reasons; build-dev-nico.py passes
# the build/runtime container for the HOST arch (aarch64 or x86_64).
ARG CONTAINER_BUILD_AARCH64
ARG CONTAINER_RUNTIME_AARCH64
# GNU triplet of the target arch — kea looks for hook libraries under
# /usr/lib/<triplet>/kea/hooks. Passed by build-dev-nico.py (20260902-#10).
ARG GNU_TRIPLET=aarch64-linux-gnu

FROM $CONTAINER_BUILD_AARCH64 as builder
ARG VERSION
ENV VERSION $VERSION
# Cargo profile, passed by build-dev-nico.py (--profile, mandatory):
#   release = the shipped build: `cargo build --release` of the twelve packages
#             Makefile.toml's build-release task names, with sccache (slowest,
#             optimized code)
#   dev     = the Tilt build (dev/deployment/devspace/Dockerfile.core-artifacts):
#             debug profile with incremental compilation, the same twelve
#             packages, no sccache (it cannot cache incremental output). A
#             one-crate change recompiles that crate and relinks; the code
#             runs unoptimized, which the simulators do not notice.
# Both profiles build the SAME package list, never --workspace: a workspace
# build also compiles the test crates, and cargo unifies features across
# everything built together, so carbide-test-harness's dependency on
# `state-controller` with `test-support` turned the controllers' test-only
# `test_assert!` into real panics inside the production binaries
# (20261007-#3; found when nico-api crashed on "BUG: Not all objects have
# been deleted from the database after cleanup" instead of logging it).
ARG PROFILE
# cargo --jobs: passed by build-dev-nico.py from the docker daemon's
# resources (min(CPUs, GB/3), never below 2). 2 is the old fixed value.
ARG CARGO_BUILD_JOBS=2
# Names the per-checkout cargo target cache (see header, item 4).
ARG CHECKOUT_ID=shared
ENV CONTAINER_REPO_ROOT=/carbide

RUN USER=root cargo new --bin carbide
WORKDIR ./carbide
COPY . ./

# bmc-mock has a duplicate [dev-dependencies] in its Cargo.toml.
# cargo needs to parse it transitively; truncate at the second occurrence.
RUN awk 'BEGIN{n=0} /^\[dev-dependencies\]$/{n++; if(n==2){exit}} {print}' \
    crates/bmc-mock/Cargo.toml > /tmp/bmc-mock-fixed.toml && \
    mv /tmp/bmc-mock-fixed.toml crates/bmc-mock/Cargo.toml

# No CI gates in either profile. The sccache cache ID is separate from the
# production aarch64 cache (sccache-aarch64) to avoid cross-contamination.
# The cargo target directory is a cache mount (persists across builds, is
# never part of the image); the binaries are copied out of it into the
# image layer the runtime stage reads from.
# The dev profile's package list is the set behind the binaries the runtime
# stage copies, plus carbide-dhcp for the kea hook library (its cdylib).
# Keep it in step with the COPY list below; a missing binary fails the COPY.
RUN --mount=type=cache,id=sccache-aarch64-dev,target=/sccache \
    --mount=type=cache,id=nico-dev-target-${CHECKOUT_ID},target=/target \
    --mount=type=cache,id=nico-dev-cargo-registry,target=/usr/local/cargo/registry \
  export DATABASE_URL="postgresql://root@%2Fvar%2Frun%2Fpostgresql/root" && \
  export CARGO_TARGET_DIR=/target && \
  /etc/init.d/postgresql start && \
  sudo -u postgres psql -c "ALTER USER root WITH SUPERUSER;" && \
  createdb root && \
  case "${PROFILE}" in \
    release) \
      export SCCACHE_DIR=/sccache RUSTC_WRAPPER=sccache CARGO_PROFILE_RELEASE_DEBUG=false && \
      cargo build --release --jobs "${CARGO_BUILD_JOBS}" \
        -p carbide-api -p carbide-pxe -p carbide-dns -p nico-admin-cli \
        -p carbide-dsx-exchange-consumer -p carbide-agent -p carbide-dhcp-server \
        -p carbide-health -p carbide-log-parser -p carbide-ssh-console \
        -p carbide-bmc-proxy -p carbide-dhcp && \
      out=/target/release ;; \
    dev) \
      cargo build --jobs "${CARGO_BUILD_JOBS}" \
        -p carbide-api -p carbide-pxe -p carbide-dns -p nico-admin-cli \
        -p carbide-dsx-exchange-consumer -p carbide-agent -p carbide-dhcp-server \
        -p carbide-health -p carbide-log-parser -p carbide-ssh-console \
        -p carbide-bmc-proxy -p carbide-dhcp && \
      out=/target/debug ;; \
    *) echo "PROFILE must be release or dev, got '${PROFILE}' (build-dev-nico.py --profile)" >&2; exit 1 ;; \
  esac && \
  mkdir -p /carbide/target/bin && \
  find "$out" -maxdepth 1 -type f -executable -exec cp -t /carbide/target/bin {} +

FROM $CONTAINER_RUNTIME_AARCH64
# Recorded so build-dev-nico.py can tell, from the registry alone, which
# profile and commit an existing tag was built from (same-tag check).
ARG PROFILE
ARG VERSION
LABEL io.nico-dev.profile="${PROFILE}" io.nico-dev.version="${VERSION}"
RUN mkdir -p /opt/carbide/migrations && \
    mkdir -p /opt/carbide/pxe/templates && \
    mkdir -p /opt/carbide/scout-firmware-scripts && \
    mkdir -p /opt/carbide/static

COPY --from=builder \
    "/carbide/target/bin/carbide-api" \
    "/carbide/target/bin/carbide" \
    "/carbide/target/bin/carbide-dns" \
    "/carbide/target/bin/nico-admin-cli" \
    "/carbide/target/bin/carbide-dsx-exchange-consumer" \
    "/carbide/target/bin/forge-dpu-agent" \
    "/carbide/target/bin/forge-dhcp-server" \
    "/carbide/target/bin/forge-hw-health" \
    "/carbide/target/bin/forge-log-parser" \
    "/carbide/target/bin/ssh-console" \
    "/carbide/target/bin/carbide-bmc-proxy" \
    "/opt/carbide/"

# kea hooks library path is per GNU triplet (aarch64-linux-gnu / x86_64-linux-gnu);
# ARGs declared before the first FROM must be re-declared to be visible here.
ARG GNU_TRIPLET
COPY --from=builder /carbide/target/bin/libdhcp.so /usr/lib/${GNU_TRIPLET}/kea/hooks/
RUN mkdir -p /usr/lib/kea/hooks && \
    ln -sf /usr/lib/${GNU_TRIPLET}/kea/hooks/libdhcp.so /usr/lib/kea/hooks/libdhcp.so

RUN ln -s /opt/carbide/nico-admin-cli /opt/carbide/carbide-admin-cli && \
    ln -s /opt/carbide/nico-admin-cli /opt/carbide/forge-admin-cli

COPY crates/api-db/migrations/ /opt/carbide/migrations/
COPY pxe/templates/*            /opt/carbide/pxe/templates/
COPY pxe/scout-firmware-scripts/ /opt/carbide/scout-firmware-scripts/
COPY crates/api/casbin-policy.csv /opt/carbide/

ENV CASBIN_POLICY_FILE=/opt/carbide/casbin-policy.csv
